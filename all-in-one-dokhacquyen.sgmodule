#!url=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/all-in-one-dokhacquyen.sgmodule
#!name=All In One - DoKhacQuyen
#!desc=Locket Gold + YouTube, Spotify, PicsArt, Lightroom, Wink, CamScanner, Meitu...
#!author=DoKhacQuyen94
#!homepage=https://github.com/DoKhacQuyen94/locket-mod
#!icon=https://github.com/DoKhacQuyen94.png

[Rule]
# Chan UDP/QUIC cho Locket & YouTube de Shadowrocket MITM bat duoc
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.rc-backup.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[URL Rewrite]
# Chan quang cao Google Video & YouTube
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Script]
# === LOCKET GOLD (Tu host, khong dung API ngoai) ===
revenuecat = type=http-response, pattern=^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locketlam.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https?:\/\/(api\.(revenuecat|rc-backup)\.com|firebaseremoteconfig\.googleapis\.com)\/.+, script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/deleteHeader.js, timeout=60
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locket_remote.js, requires-body=true, max-size=-1, timeout=60
locket_badge = type=http-request, pattern=^https?:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locket_profile.js, timeout=60
locket_user = type=http-response, pattern=^https?:\/\/api\.locketcamera\.com\/((users?|profiles?)\/.+|getUser.*), script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locket_profile.js, requires-body=true, max-size=1048576, timeout=60
locket_pb_req = type=http-request, pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(generateFilteredImage|photoboothMoment|photobooth), requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locket_pb_req.js, timeout=60
locket_filter_resp = type=http-response, pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage, requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/DoKhacQuyen94/locket-mod/main/scripts/locket_filter_resp.js, timeout=60

# === CAC APP KHAC (Tich hop tu All_in_one) ===
# YouTube Premium (PiP, Background Play, No Ads)
youtube.request = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|reel\/reel_watch_sequence|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/youtube.response.js
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/youtube.response.js,argument="{"lyricLang":"vi","captionLang":"vi","blockUpload":true,"blockImmersive":true,"debug":false}"

# Spotify Premium
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/spotify-json.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/spotify-proto.js,script-update-interval=0

# SoundCloud Go+
SoundCloudGo+ = type=http-response,pattern=https://api-mobile.soundcloud.com/configuration/ios,requires-body=1,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/SoundCloudGoPlus.js

# AlightMotion
AlightMotion = type=http-response,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/AlightMotion.js,pattern=^https:\/\/us-central1-alight-creative\.cloudfunctions\.net\/getAccountStatusAndLicenses,max-size=131072,requires-body=true,timeout=10,enable=true

# PicsArt
PicsArt = type=http-request,pattern=^https:\/\/api\.picsart\.com\/gw-v2\/shop\/subscription\/apple\/purchases,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/PicsArt.js,requires-body=true,timeout=60
PicsArtStorages = type=http-response,pattern=^https:\/\/api\.picsart\.com\/gw-v2\/cloud-storage\/v1\/me\/storages,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/PicsArtStorages.js,requires-body=1,max-size=0

# Wink
Wink = type=http-response,pattern=^https:\/\/api-sub\.meitu\.com\/v2\/user\/vip_info_by_group\.json,requires-body=1,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/WinkVipCrack.js

# Truecaller
Truecaller = type=http-response,pattern=^https:\/\/premium-[^.]+\.truecaller\.com\/v\d+\/(subscriptions\/status|products\/apple)(\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/TrueCaller.js

# Lightroom
Lightroom = type=http-response,pattern=^https:\/\/photos\.adobe\.io\/v\d\/accounts,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/lightroom.js,script-update-interval=-1

# Kinemaster
Kinemaster = type=http-response,pattern=^https:\/\/api-account\.kinemasters\.com\/v\d\/user\/subscribe$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/Kinemaster.js

# CamScanner
Camscanner = requires-body=1,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/camScanner.js,type=http-response,pattern=^https:\/\/(api|api-cs.*)\.intsig\.net\/purchase\/cs\/query_property\?

# BeautyPlus
BeautyPlus = type=http-response, pattern=https:\/\/(api\.mr\.pixocial\.com\/v1\/manual_unlock|newbeee-api\.beautyplus\.com\/api\/v1\/asset\/balance), script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/BeautyPlus.js, requires-body=true, max-size=-1, timeout=60

# iTunes
iTunes = type=http-response, pattern=^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$, script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/iTunes.js, requires-body=true, max-size=-1, timeout=60

# Snow
Snow = type=http-response, pattern=^https?:\/\/user-snow-api\.snow\.me\/v\d\/purchase\/subscription\/subscriber\/status, script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/Snow.js, requires-body=true, max-size=-1, timeout=60

# Meitu
Meitu = type=http-response,pattern=^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/v\d\/(h\d\/vip|vip|user)\/,requires-body=1,script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/MeiTuXiuXiu.js

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, -redirector*.googlevideo.com, premium*.truecaller.com, buy.itunes.apple.com, spclient.wg.spotify.com, *spclient.spotify.com, api-mobile.soundcloud.com, api.picsart.com, us-central1-alight-creative.cloudfunctions.net, api-sub.meitu.com, photos.adobe.io, ap*.intsig.net, api-account.kinemasters.com, api.mr.pixocial.com, newbeee-api.beautyplus.com, user-snow-api.snow.me, h5.xiuxiu.meitu.com, api.xiuxiu.meitu.com
